APP_ENV=development
PORT=8080
LOG_LEVEL=debug
DATABASE_URL=postgres://identity_app:CHANGE_ME@localhost:5432/identity?sslmode=disable&search_path=identity
APISPERU_BASE_URL=https://dniruc.apisperu.com/api/v1
APISPERU_TOKEN=
APISPERU_TIMEOUT_SECONDS=10

# Our own cap on APIs Peru calls per calendar month (America/Lima). Keep it below the plan quota.
APISPERU_MONTHLY_LIMIT=900

# Public key and issuer of ATM-Auth-API: lets systems call with their service token
# (Authorization: Bearer) instead of an X-API-Key. Set both or neither.
AUTH_PUBLIC_KEY_BASE64=
AUTH_ISSUER=
